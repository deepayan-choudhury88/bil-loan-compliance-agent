# Copy this file to .env and fill in real values. .env is git-ignored;
# .env.example is not, so it's safe to commit as a template.
#
# retrieval/provider.py picks Azure OpenAI automatically if either
# AZURE_OPENAI_ENDPOINT or AZURE_OPENAI_API_KEY is set below - otherwise it
# falls back to plain OpenAI (OPENAI_API_KEY).

# ---- Option A: Azure OpenAI --------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Deployment names as configured in your Azure OpenAI resource:
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---- Option B: plain OpenAI (used only if the Azure vars above are empty) ---
OPENAI_API_KEY=

# ---- Optional overrides -------------------------------------------------
# RAG_LLM_MODEL=
# RAG_EMBEDDING_MODEL=
# SUGGESTION_API_URL=http://127.0.0.1:8000/suggest
